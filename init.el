(menu-bar-mode -1)
(tool-bar-mode -1)
(setq inhibit-startup-message t)
(global-display-line-numbers-mode t)

(setq gc-cons-threshold (or bedrock--initial-gc-threshold 800000))

;; System clipboard integration for terminal frames. On Wayland prefer
;; wl-copy/wl-paste (from wl-clipboard) when available.
(use-package xclip
  :ensure t
  :config
  (when (and (getenv "WAYLAND_DISPLAY") (executable-find "wl-copy"))
    (setq xclip-method 'wl-copy))
  (xclip-mode 1))

(use-package ghostel
  :ensure t)

(use-package claude-code-ide
  :vc (:url "https://github.com/manzaltu/claude-code-ide.el" :rev :newest)
  :bind ("C-c C-'" . claude-code-ide-menu) ; Set your favorite keybinding
  :config
  (claude-code-ide-emacs-tools-setup)
  ) ; Optionally enable Emacs MCP tools
(setq claude-code-ide-terminal-backend 'ghostel)

(use-package treemacs
  :ensure t
  :defer t
  :bind (("<f8>" . treemacs)            ; toggle the sidebar
         ("C-c t s" . treemacs-select-window))
  :config
  (setq treemacs-width 30
        treemacs-follow-after-init t)
  (treemacs-follow-mode t)              ; highlight the file you're visiting
  (treemacs-filewatch-mode t)           ; refresh when files change on disk
  (treemacs-fringe-indicator-mode 'always)
  (treemacs-git-mode 'simple)           ; git status colors
  ;; Expand/collapse with a single left click instead of a double click
  (define-key treemacs-mode-map [mouse-1] #'treemacs-single-click-expand-action))

;; Keep the tree open at startup, showing the project Emacs was started from
(defun my/treemacs-startup ()
  (require 'treemacs)
  (if (treemacs--find-current-user-project)
      (treemacs-add-and-display-current-project-exclusively)
    (treemacs)))

(add-hook 'emacs-startup-hook #'my/treemacs-startup)

(use-package treemacs-projectile
  :ensure t
  :after (treemacs projectile))

(use-package treemacs-nerd-icons
  :ensure t
  :after treemacs
  :config
  (treemacs-load-theme "nerd-icons"))

(use-package terraform-mode
  :ensure t
  :hook (terraform-mode . eglot-ensure))

(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs
               '(terraform-mode . ("terraform-ls" "serve"))))
